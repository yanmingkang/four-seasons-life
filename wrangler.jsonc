{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhihu-four-seasons",
  "account_id": "95a771c31ccba62a6e5417db883a3769",
  "main": "server/cloudflare-entry.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://zhihu-four-seasons.pages.dev",
    "ZHIHU_OAUTH_APP_ID": "448",
    "ZHIHU_OAUTH_REDIRECT_URI": "https://zhihu-four-seasons.pages.dev/api/auth/zhihu/callback",
    // Set to true only after exact registration + App ID and secret App Key.
    "ZHIHU_OAUTH_REGISTERED": "true"
  },
  "assets": {
    // Deployment must pass --assets with the audited prepare-cloud-release output.
    "directory": ".cloud-release/unprepared",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_SERVICE", "class_name": "GameService" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameService"] }],
  "observability": { "enabled": false }
}
